// NEOLIFE — Traffic MVP application schema (Prisma 7).
//
// NOTE (per docs/PROJECT_PLAN.md §11.1 and docs/DECISIONS.md D-003):
// - The CRM lifecycle is the Owner-approved INITIAL model; statuses are enums but
//   must remain data-driven/extensible. Do not hard-code business assumptions
//   beyond the approved MVP requirement.
// - Better Auth owns the auth tables (user/session/account/verification) externally;
//   they are intentionally NOT defined in this schema.
// - "Registration" here records business interest / office-pipeline entry only.
//   This platform is NOT the authoritative NeoLife distributor-registration system.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Separate personal contact intake, never an implicit Lead or NEW_LEAD.
// Batch B/C will use the reserved queue/review states and import metadata.
enum ContactState {
  MAIN
  IMPORTED_QUEUE
  DUPLICATE_REVIEW
  ARCHIVED
  MERGED
  CONTACT_POOL
  TRANSFER_PENDING
}

enum ContactOrigin {
  MANUAL
  IMPORT
}

enum ContactConsentStatus {
  UNKNOWN
  GRANTED
  DENIED
}

enum ContactMethodType {
  PHONE
  EMAIL
}

// Batch D: explicit, human-reviewed imported-queue decisions.
enum ContactQueueReviewOutcome {
  APPROVED
  REJECTED
}

enum ContactFollowUpKind {
  INTERNAL
  CALL
  EMAIL
}

enum ContactFollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Contact {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // NULL only if Better Auth deletes the owner. Contacts remain recoverable
  // under explicit Owner oversight; staff never see orphaned records.
  ownerUserId   String?
  ownerSnapshot String
  firstName     String
  lastName      String?
  city          String?
  sourceDetail  String?
  notes         String?
  consentEvidence String? // recorder-provided permission provenance; required when GRANTED
  consentUpdatedAt DateTime?
  doNotContactAt DateTime?
  version       Int                  @default(1) // optimistic concurrency guard
  origin        ContactOrigin        @default(MANUAL)
  state         ContactState         @default(MAIN)
  consentStatus ContactConsentStatus @default(UNKNOWN)
  doNotContact  Boolean              @default(false)
  queueReviewOutcome ContactQueueReviewOutcome?
  queueReviewedAt DateTime?
  queueReviewedByUserId String?
  queueReviewedBySnapshot String?
  queueReviewReason String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  owner   User?               @relation("user_owned_contacts", fields: [ownerUserId], references: [id], onDelete: SetNull)
  methods ContactMethod[]
  audit   ContactAuditEvent[]
  queueReviewer User? @relation("user_contact_queue_review", fields: [queueReviewedByUserId], references: [id], onDelete: SetNull)
  followUps ContactFollowUp[]
  importBatchId String? @db.Uuid
  importRowNumber Int?
  importBatch ContactImportBatch? @relation("batch_contacts", fields: [importBatchId], references: [id], onDelete: SetNull)
  importRow ContactImportRow? @relation("imported_row_contact")
  // A merge never deletes the original contact or its import/audit trail.
  mergedIntoContactId String? @db.Uuid
  mergedAt DateTime?
  mergedInto Contact? @relation("ContactMergeLineage", fields: [mergedIntoContactId], references: [id], onDelete: SetNull)
  mergedFrom Contact[] @relation("ContactMergeLineage")
  transfers ContactTransfer[]
  duplicateLeftIssues ContactDuplicateIssue[] @relation("ContactDuplicateLeft")
  duplicateRightIssues ContactDuplicateIssue[] @relation("ContactDuplicateRight")

  @@index([ownerUserId, state, createdAt])
  @@index([state, createdAt])
  @@index([mergedIntoContactId])
  @@index([importBatchId, importRowNumber])
  @@index([ownerUserId, queueReviewOutcome, queueReviewedAt])
  @@unique([importBatchId, importRowNumber])
}

// Multiple methods permit shared household numbers and duplicate candidates.
// No global unique constraint: Batch C will detect conflicts for manual review.
model ContactMethod {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId       String            @db.Uuid
  type            ContactMethodType
  value           String
  normalizedValue String
  isPrimary       Boolean           @default(false)
  createdAt       DateTime          @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, type, normalizedValue])
  @@index([type, normalizedValue])
  @@index([contactId, type])
}

// Append-only audit rows for recovery, future duplicate/merge investigations
// and accountable manual changes. The UI never edits or deletes audit rows.
model ContactAuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId   String   @db.Uuid
  actorUserId String?
  actorSnapshot String
  action      String
  reason      String? // required when a Do Not Contact restriction is lifted
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  actor   User?   @relation("user_contact_audit", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([actorUserId, createdAt])
}

// Batch D: Contact-only tasks. There is intentionally no Lead foreign key.
model ContactFollowUp {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId String @db.Uuid
  kind ContactFollowUpKind
  status ContactFollowUpStatus @default(OPEN)
  note String
  dueAt DateTime
  version Int @default(1)
  createdByUserId String?
  createdBySnapshot String
  resolvedByUserId String?
  resolvedBySnapshot String?
  resolutionNote String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy User? @relation("user_contact_task_created", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("user_contact_task_resolved", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([contactId, status, dueAt])
  @@index([status, dueAt])
}

// One export audit record per authorized download, not per contact row.
model ContactExportAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?
  actorSnapshot String
  scopeAll Boolean
  category String
  view String
  rowCount Int
  createdAt DateTime @default(now())

  actor User? @relation("user_contact_exports", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

// PIN hashes protect exports after the first password-verified setup.
model ContactExportCredential {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique
  pinHash String
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactExportSecurityEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String?
  actorSnapshot String
  action String
  detail String?
  createdAt DateTime @default(now())

  actor User? @relation("user_contact_export_security", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Batch B: upload preview, user-confirmed mapping, atomic import and row-level history.
// No lead references, outbound actions, or automatic promotion are permitted.
enum ContactImportStatus {
  PREVIEW
  COMPLETE
}

enum ContactImportRowStatus {
  PENDING
  IMPORTED
  INVALID
  REJECTED
}

model ContactImportBatch {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId    String?
  ownerSnapshot  String
  filename       String
  fileType       String
  fileSha256     String
  status         ContactImportStatus @default(PREVIEW)
  headers        Json
  mapping        Json?
  totalRows      Int
  importedRows   Int @default(0)
  invalidRows    Int @default(0)
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  owner          User? @relation("user_contact_imports", fields: [ownerUserId], references: [id], onDelete: SetNull)
  rows           ContactImportRow[]
  contacts       Contact[] @relation("batch_contacts")

  @@unique([ownerUserId, fileSha256])
  @@index([ownerUserId, createdAt])
}

model ContactImportRow {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId      String @db.Uuid
  rowNumber    Int
  values       Json
  status       ContactImportRowStatus @default(PENDING)
  error        String?
  contactId    String? @unique @db.Uuid
  correctedValues Json?
  correctionCount Int @default(0)
  lastCorrectedAt DateTime?
  lastCorrectedBySnapshot String?
  createdAt    DateTime @default(now())

  batch        ContactImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact      Contact? @relation("imported_row_contact", fields: [contactId], references: [id], onDelete: SetNull)
  corrections ContactImportRowCorrection[]

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

// Append-only corrections preserve original imported cells and every revalidation attempt.
model ContactImportRowCorrection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rowId String @db.Uuid
  actorUserId String?
  actorSnapshot String
  submittedValues Json
  validationPassed Boolean
  validationError String?
  createdAt DateTime @default(now())

  row ContactImportRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  actor User? @relation("user_contact_import_row_correction", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rowId, createdAt])
  @@index([actorUserId, createdAt])
}

enum ContactTransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// A transfer is a durable hand-off request. Ownership changes only on recipient approval.
model ContactTransfer {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId String @db.Uuid
  sourceOwnerUserId String?
  sourceOwnerSnapshot String
  recipientUserId String?
  recipientSnapshot String
  requestedByUserId String?
  requestedBySnapshot String
  decidedByUserId String?
  decidedBySnapshot String?
  sourceState ContactState
  expectedContactVersion Int
  status ContactTransferStatus @default(PENDING)
  rejectionReason String?
  decisionReason String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Transfer history is durable: a contact with any transfer record cannot be hard-deleted.
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sourceOwner User? @relation("contact_transfer_source_owner", fields: [sourceOwnerUserId], references: [id], onDelete: SetNull)
  recipient User? @relation("contact_transfer_recipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  requestedBy User? @relation("contact_transfer_requester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("contact_transfer_decider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([contactId, createdAt])
  @@index([requestedByUserId, createdAt])
}

// Batch C: human-reviewed, same-owner duplicate candidates and durable decisions.
// A dismissed issue is never automatically reopened by another scan.
enum ContactDuplicateStatus {
  OPEN
  DISMISSED
  MERGED
  CLOSED
}

model ContactDuplicateIssue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String?
  ownerSnapshot String
  // Canonical UUID ordering: leftContactId < rightContactId.
  leftContactId String @db.Uuid
  rightContactId String @db.Uuid
  leftVersion Int
  rightVersion Int
  signals Json
  status ContactDuplicateStatus @default(OPEN)
  reviewedByUserId String?
  reviewedBySnapshot String?
  reviewReason String?
  reviewedAt DateTime?
  retainedContactId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User? @relation("user_contact_duplicate_owner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewer User? @relation("user_contact_duplicate_reviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  leftContact Contact @relation("ContactDuplicateLeft", fields: [leftContactId], references: [id], onDelete: Cascade)
  rightContact Contact @relation("ContactDuplicateRight", fields: [rightContactId], references: [id], onDelete: Cascade)

  @@unique([leftContactId, rightContactId])
  @@index([ownerUserId, status, createdAt])
  @@index([status, createdAt])
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  REGISTERED
  MEETING_SCHEDULED
  MEETING_ATTENDED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
  DISQUALIFIED
}

enum InterestType {
  BUSINESS
  PRODUCT
  BOTH
  UNSURE
}

enum MeetingStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

model Lead {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName          String
  lastName           String?
  phone              String
  email              String?
  city               String?
  interestType       InterestType @default(UNSURE)
  qualificationNotes String?
  consent            Boolean
  consentAt          DateTime?
  status             LeadStatus   @default(NEW_LEAD)

  // Attribution (MVP minimum — see docs/PROJECT_PLAN.md §13)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  landingPage      String?
  firstTouchSource String?

   // References User.id, which is TEXT: Better Auth generates opaque
  // alphanumeric IDs, not UUIDs. @db.Uuid here would be incorrect — a real
  // Better Auth ID is rejected by PostgreSQL as invalid uuid syntax. Keep in
  // step with Meeting.userId and FollowUp.userId.
  assignedUserId String?

  // Referral attribution (D-034) — captured ONCE at lead creation and treated
  // as immutable afterwards. referredByUserId is a snapshot of the original
  // referrer: reassignment moves Lead.assignedUserId only and MUST never touch
  // these fields. ON DELETE SET NULL keeps attribution auditably intact even
  // if the referring Staff account is later deleted.
  referredByUserId   String?
  referralCode       String?
  referralMethod     String? // "link" | "manual_name"
  referredByName     String? // manual-fallback display name, as typed by the visitor
  referralCapturedAt DateTime?
  referredBySnapshot String? // creation-time snapshot of the APPROVED public referrer name (Task #027)

   createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events    LeadEvent[]
  meetings  Meeting[]
  followUps FollowUp[]
  productInterests ProductInterest[]
  assignedUser User? @relation("user_assigned_leads", fields: [assignedUserId], references: [id], onDelete: SetNull)
  referredBy   User? @relation("user_referred_leads", fields: [referredByUserId], references: [id], onDelete: SetNull)

  // referralCode is deliberately stored as a plain TEXT value with NO foreign
  // key: revoking or deleting a ReferralCode row must never rewrite historical
  // attribution. Resolution goes through src/lib/referrals.ts lookups instead.

  funnelEvents FunnelEvent[]
  qualificationTokens QualificationToken[]
  notifications Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([utmCampaign])
  @@index([assignedUserId])
  @@index([assignedUserId, status])
  @@index([referredByUserId])
  @@index([referralCode])
}

// First-party funnel events (D-005) — NOT a custom analytics platform.
model LeadEvent {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId   String? @db.Uuid
  type     String
  metadata Json?
  // References User.id (TEXT — Better Auth generates opaque IDs, not UUIDs).
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

// Office pipeline — deliberately simple (docs/PROJECT_PLAN.md §11.3).
model Meeting {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String        @db.Uuid
  scheduledAt DateTime
  status      MeetingStatus @default(SCHEDULED)
  outcome     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

model FollowUp {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId  String @db.Uuid
  note    String

  // Phase 2: null dueAt means an ordinary existing CRM note, not a task.
  // completedAt remains null while a scheduled task is outstanding.
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dueAt, completedAt])
}

// ---------------------------------------------------------------------------
// Better Auth (Task 1.7) — auth tables owned by Better Auth's Prisma adapter.
// `role` distinguishes the office/admin boundary ("admin" can access the CRM).
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("staff")
  // Task #037 — contactable profile and notification preference. Both are
  // optional and NON-AUTHORIZING: they never affect role/isActive checks.
  // `phone` supports e.g. click-to-call for the two office users;
  // `notificationEmail` overrides WHERE operational notifications are sent
  // (falls back to the Better Auth login `email` when null/blank).
  phone             String?
  notificationEmail String?
  mustChangePassword Boolean @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
  assignedLeads Lead[] @relation("user_assigned_leads")
  referredLeads Lead[] @relation("user_referred_leads")
  referralCode  ReferralCode?
  notifications Notification[]
  events LeadEvent[]
  ownedContacts Contact[] @relation("user_owned_contacts")
  contactAuditEvents ContactAuditEvent[] @relation("user_contact_audit")
  contactImports ContactImportBatch[] @relation("user_contact_imports")
  contactDuplicateIssues ContactDuplicateIssue[] @relation("user_contact_duplicate_owner")
  contactDuplicateReviews ContactDuplicateIssue[] @relation("user_contact_duplicate_reviewer")
  contactQueueReviews Contact[] @relation("user_contact_queue_review")
  contactTasksCreated ContactFollowUp[] @relation("user_contact_task_created")
  contactTasksResolved ContactFollowUp[] @relation("user_contact_task_resolved")
  contactExports ContactExportAudit[] @relation("user_contact_exports")
  contactExportCredential ContactExportCredential?
  contactExportSecurityEvents ContactExportSecurityEvent[] @relation("user_contact_export_security")
  contactImportRowCorrections ContactImportRowCorrection[] @relation("user_contact_import_row_correction")
  contactTransfersFrom ContactTransfer[] @relation("contact_transfer_source_owner")
  contactTransfersTo ContactTransfer[] @relation("contact_transfer_recipient")
  contactTransfersRequested ContactTransfer[] @relation("contact_transfer_requester")
  contactTransfersDecided ContactTransfer[] @relation("contact_transfer_decider")
}

// Staff referral links (D-034). One code per Staff user; Owner-managed.
// Codes are 128-bit random, URL-safe and opaque — they never embed or leak
// Better Auth user IDs. `publicName` is the approved public-facing display
// name used by the manual "Who referred you?" fallback.
model ReferralCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @unique
  code       String    @unique
  isActive   Boolean   @default(true)
  publicName String
  /** Task #029 (D-034): normalized lookup key for the public referral name
   *  (trimmed, internal whitespace collapsed, lower-cased) so storage and
   *  lookup always agree. NULL once revoked — freeing the name for reuse —
   *  and NULL for legacy rows whose normalized name collided with another
   *  ACTIVE row at migration time (preserved, reported; never resolvable
   *  until the Owner re-registers the name). Unique across ALL rows: two
   *  NULLs are allowed by PostgreSQL (NULLs are distinct), so revoked and
   *  collision-quarantined rows can coexist while at most ONE active row per
   *  normalized name exists — the ambiguity guard becomes race-safe via this
   *  atomic constraint. */
  publicNameNormal String? @unique
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Task #029, Fix 4 — durable outbound-email send reservation (rate limiting).
 *
 * Rows are inserted ATOMICALLY inside a short claim transaction (serialized
 * by a PostgreSQL advisory lock) BEFORE any provider call, making the
 * per-lead 90s interval and the 20-per-sender-hour cap race-safe. The row
 * also persists an auditable attempt identity before external sending.
 *
 * status lifecycle: reserved → accepted | failed | unknown | simulated.
 * Every status counts conservatively against both limits, so failures
 * (including provider timeouts recorded as "unknown" and finalization
 * failures, which leave the row "reserved") can never reopen the limit.
 * leadId is a plain string with no FK: the attempt audit trail must survive
 * lead deletion and rows naturally expire out of the rate windows.
 */
model EmailSendReservation {
  id         String   @id @default(uuid())
  leadId     String
  userId     String
  reservedAt DateTime @default(now())
  status     String   @default("reserved")

  @@index([leadId, reservedAt])
  @@index([userId, reservedAt])
}


// In-app notifications (D-034, Phase 3). Per-recipient, deduplicated by
// dedupKey so delivery retries never create duplicates.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  leadId    String?   @db.Uuid
  type      String
  title     String
  body      String?
  dedupKey  String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([leadId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  subject               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ---------------------------------------------------------------------------
// Product Catalogue (Phase 4 precursor — planning: docs/PRODUCT_CATALOGUE_PLAN.md)
// ---------------------------------------------------------------------------

enum InterestStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
}

model Category {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique   // official category name, e.g. "Nutritionals"
  slug         String         @unique   // URL slug, e.g. "nutritionals"
  description  String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subcategories Subcategory[]
  products      ProductCategory[]
}

model Subcategory {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String         @db.Uuid
  name         String                     // official subcategory name, e.g. "Core Products"
  slug         String                     // e.g. "core-products"
  description  String?
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products ProductSubcategory[]

  @@index([categoryId])
  @@unique([categoryId, slug])
}

model Product {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String                          // official product name
  slug         String            @unique        // stable, derived from official URL
  sku          String?                           // official item number, e.g. "942"
  description  String?                           // original concise summary
  imageUrl     String?                           // placeholder until licensed imagery approved
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  categories    ProductCategory[]
  subcategories ProductSubcategory[]
  interests     ProductInterest[]

  @@index([slug])
  @@index([sku])
}

model ProductCategory {
  productId String   @db.Uuid
  categoryId String  @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
}

model ProductSubcategory {
  productId     String      @db.Uuid
  subcategoryIds String     @db.Uuid
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  subcategory   Subcategory  @relation(fields: [subcategoryIds], references: [id], onDelete: Cascade)

  @@unique([productId, subcategoryIds])
}

model ProductInterest {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String         @db.Uuid
  leadId        String?        @db.Uuid
  status        InterestStatus @default(NEW)
  message       String?
  notificationSent Boolean      @default(false)
  notificationSentAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

    @@index([productId])
    @@index([leadId])
    @@index([status])
    @@index([createdAt])
}

// Referential actions and timestamp precision here follow the normal Prisma
// conventions (ON UPDATE CASCADE, TIMESTAMP(3)), matching every
// Prisma-generated table in this schema. The hand-written
// 20260918000000_add_funnel_events migration omitted both; they were restored
// by 20261003000000_align_funnel_event_conventions.
model FunnelEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String
  leadId    String?  @db.Uuid
  attribution Json?
  deviceId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([leadId])
  @@index([createdAt])
  @@index([deviceId])
  @@index([deviceId, createdAt])
}

// Referential actions and timestamp precision here follow the normal Prisma
// conventions (ON UPDATE CASCADE, TIMESTAMP(3)). See the note on FunnelEvent.
model QualificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId     String    @db.Uuid
  nonce      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([expiresAt])
  @@index([consumedAt])
}
