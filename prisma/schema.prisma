// NEOLIFE — Traffic MVP application schema (Prisma 7).
//
// NOTE (per docs/PROJECT_PLAN.md §11.1 and docs/DECISIONS.md D-003):
// - The CRM lifecycle is the Owner-approved INITIAL model; statuses are enums but
//   must remain data-driven/extensible. Do not hard-code business assumptions
//   beyond the approved MVP requirement.
// - Better Auth owns the auth tables (user/session/account/verification) externally;
//   they are intentionally NOT defined in this schema.
// - "Registration" here records business interest / office-pipeline entry only.
//   This platform is NOT the authoritative NeoLife distributor-registration system.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  REGISTERED
  MEETING_SCHEDULED
  MEETING_ATTENDED
  FOLLOW_UP
  CONVERTED
  NOT_INTERESTED
  DISQUALIFIED
}

enum InterestType {
  BUSINESS
  PRODUCT
  BOTH
  UNSURE
}

enum MeetingStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

model Lead {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName          String
  lastName           String?
  phone              String
  email              String?
  city               String?
  interestType       InterestType @default(UNSURE)
  qualificationNotes String?
  consent            Boolean
  consentAt          DateTime?
  status             LeadStatus   @default(NEW_LEAD)

  // Attribution (MVP minimum — see docs/PROJECT_PLAN.md §13)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?
  landingPage      String?
  firstTouchSource String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  events    LeadEvent[]
  meetings  Meeting[]
  followUps FollowUp[]

  @@index([status])
  @@index([createdAt])
  @@index([utmCampaign])
}

// First-party funnel events (D-005) — NOT a custom analytics platform.
model LeadEvent {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId   String? @db.Uuid
  type     String
  metadata Json?
  lead     Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

// Office pipeline — deliberately simple (docs/PROJECT_PLAN.md §11.3).
model Meeting {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String        @db.Uuid
  scheduledAt DateTime
  status      MeetingStatus @default(SCHEDULED)
  outcome     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([scheduledAt])
}

model FollowUp {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId  String @db.Uuid
  note    String

  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}
