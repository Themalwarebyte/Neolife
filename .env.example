# NEOLIFE environment template — copy to .env and fill in real values.
# NEVER commit the real .env file.

# PostgreSQL connection (local development)
DATABASE_URL="postgresql://neolife:CHANGE_ME@localhost:5432/neolife?schema=public"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
